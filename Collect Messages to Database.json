    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=Привет! Я — бот Статус Ниндзя 🥷\nЧитаю проектные чаты и собираю статусы, дедлайны и риски,\nчтобы вам не приходилось выяснять, что происходит.\n\nЯ обрабатываю Telegram ID, имя и сообщения в чате в соотвествии с законодательством. Серверы находятся в России и после проекта данные удаляются.\n\nОставаясь здесь, вы соглашаетесь с [политикой](https://drive.google.com/file/d/1Mkrxyt6un8yDYt9qaui7O0IVR2tV1DP9/view) обработки персональных данных.\nУдалить меня можно через продюсера.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        896,
        -128
      ],
      "id": "2ee67315-a758-4353-8cd2-5c75c3d91710",
      "name": "Send a text message",
      "webhookId": "589639b1-1c56-49f4-aa49-48c97df4573d",
      "credentials": {
        "telegramApi": {
          "id": "jDKc1tJGIW7LLK1W",
          "name": "Tech CultPro Bot"
        }
      }
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        848,
        96
      ],
      "id": "98719d71-96f0-4583-ad47-632bd6653fd3",
      "name": "No Operation, do nothing"
    },
    {
      "parameters": {
        "jsCode": "// Извлекаем данные сообщения\nconst items = $input.all();\n\nreturn items.map(item => {\n  const message = item.json.message || {};\n  const text = message.text || '';\n  const entities = message.entities || [];\n  \n  // Собираем все ссылки из entities\n  const links = [];\n  \n  entities.forEach(entity => {\n    if (entity.type === 'url') {\n      // Обычная ссылка в тексте\n      const url = text.substring(entity.offset, entity.offset + entity.length);\n      links.push(url);\n    } else if (entity.type === 'text_link') {\n      // Гиперссылка (скрытая ссылка под текстом)\n      links.push(entity.url);\n    }\n  });\n  \n  // Формируем полный текст с ссылками\n  let fullText = text;\n  if (links.length > 0) {\n    fullText += '\\n\\nСсылки:\\n' + links.join('\\n');\n  }\n  \n  return {\n    json: {\n      ...item.json,\n      message: {\n        ...message,\n        text: fullText,\n        extracted_links: links\n      }\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
