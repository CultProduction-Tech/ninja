    {
      "parameters": {
        "jsCode": "// Подсчет количества входящих items с проверкой на пустые данные\nconst allItems = $input.all();\nlet itemCount = 0;\n\n// Проверяем, есть ли реальные данные\nif (allItems && allItems.length > 0) {\n  // Проверяем, не является ли единственный item пустым объектом\n  if (allItems.length === 1 && (!allItems[0].json || Object.keys(allItems[0].json).length === 0)) {\n    itemCount = 0;\n  } else {\n    itemCount = allItems.length;\n  }\n}\n\nreturn [\n  {\n    json: {\n      count: itemCount,\n      timestamp: new Date().toISOString()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1248,
        16
      ],
      "id": "2e59bc23-a1d5-4e89-9f43-d9f7a7fb1a7c",
      "name": "Count new messages"
    },
